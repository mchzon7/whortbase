<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wallet - Naija Whot</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>body { background-color: #121212; color: #fff; }</style>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <script src="https://js.paystack.co/v1/inline.js"></script>
</head>
<body>
  <div class="container my-5 col-md-6">
    <!-- Balance & Payment Operations Card -->
    <div class="card bg-dark text-white border-secondary p-4 mb-4">
      <h3 class="text-warning">Wallet & Cashout</h3>
      <p>Current Points Balance: <strong class="text-success"><%= user.pointsBalance %></strong></p>
      <hr class="border-secondary">
      
      <h5>Deposit Points (1 NGN = 1 Point)</h5>
      <div class="input-group mb-3">
        <input type="number" id="depositAmount" class="form-control bg-dark text-white border-secondary" placeholder="Amount (min 100)">
        <button class="btn btn-warning" onclick="depositPaystack()">Paystack Deposit</button>
      </div>
      <hr class="border-secondary">

      <h5>Withdraw via FaucetPay (Crypto)</h5>
      <div class="mb-3">
        <label for="fpAddress">Address/Email</label>
        <input type="text" id="fpAddress" class="form-control bg-dark text-white border-secondary mb-2" placeholder="FaucetPay Address/Email">
        <label for="fpAmount">Points (min 1000)</label>
        <input type="number" id="fpAmount" class="form-control bg-dark text-white border-secondary mb-2" placeholder="Points (min 1000)">
        <button class="btn btn-outline-warning w-100" onclick="withdrawFP()">Request USDT Payout</button>
      </div>
      <hr class="border-secondary">
    </div>

    <!-- TimeWall Offerwall Embedded iFrame Card -->
    <div class="card bg-dark text-white border-secondary p-4 mb-4 offerwall-section">
      <h3 class="text-warning mb-3">Earn Free Points</h3>
      <p>Complete tasks, surveys, and offers below to earn instant points!</p>
      
      <div class="timewall-container mt-3">
        <iframe 
          title="TimeWall" 
          src="https://timewall.io/users/login?oid=a06765b6293c33f4&uid=<%= user._id %>" 
          frameborder="0" 
          width="100%" 
          height="1000" 
          scrolling="auto">
        </iframe>
      </div>
    </div>

    <!-- Referral System Card -->
    <div class="card bg-dark text-white border-secondary p-4 mb-4 referral-card">
      <h3 class="text-warning">Invite & Earn</h3>
      <p>Share your referral link. Earn <strong>50 points</strong> when your referral deposits 500 points or more!</p>
      
      <input type="text" class="form-control bg-dark text-white border-secondary mb-2" id="refLink" value="https://t.me/Bwootbot/bwoot?startapp=<%= user.referralCode %>" readonly />
      <button class="btn btn-outline-warning w-100" onclick="copyReferralLink()">Copy Link</button>
    </div>

    <a href="/dashboard" class="btn btn-secondary w-100 mb-5">Back to Dashboard</a>
  </div>

  <script>

 async function depositPaystack() {
  const amountInput = document.getElementById('depositAmount');
  const amount = parseFloat(amountInput.value);

  if (!amount || amount <= 0) {
    alert('Please enter a valid amount.');
    return;
  }

  try {
    // 1. Get transaction reference and email from your backend
    const response = await fetch('/api/deposit/paystack', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amount })
    });

    const data = await response.json();

    if (!data.success) {
      alert(data.message || 'Initialization failed.');
      return;
    }

    // 2. Open Paystack Inline Modal inside Telegram
    const handler = PaystackPop.setup({
      key: '<%= procee %>', // Pass public key from backend or env
      email: data.email,
      amount: Math.round(amount * 100), // In kobo
      ref: data.reference,
      onClose: function() {
        alert('Payment cancelled.');
      },
      callback: function(response) {
        // Automatically trigger verification on completion
        window.location.href = `/wallet/verify?reference=${response.reference}`;
      }
    });

    handler.openIframe();

  } catch (err) {
    console.error('Deposit Error:', err);
    alert('An error occurred while initializing payment.');
  }
}

    async function withdrawFP() {
      const address = document.getElementById('fpAddress').value;
      const amount = document.getElementById('fpAmount').value;
      const res = await fetch('/api/withdraw/faucetpay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ address, amount })
      });
      const data = await res.json();
      alert(data.message || data.error);
    }
  </script>
  <script>
    async function handleBinanceWithdraw(event) {
      event.preventDefault();

      const amount = parseFloat(document.getElementById('binanceAmount').value);
      const binancePayId = document.getElementById('binancePayId').value.trim();

      if (!amount || amount <= 0 || !binancePayId) {
        alert('Please enter a valid amount and Binance Pay ID.');
        return;
      }

      try {
        const response = await fetch('/api/withdraw/binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, binancePayId, currency: 'USDT' })
        });

        const data = await response.json();

        if (data.success) {
          alert(data.message || 'Withdrawal successful!');
          window.location.reload();
        } else {
          alert(data.message || 'Withdrawal failed.');
        }
      } catch (err) {
        console.error('Binance Withdrawal Exception:', err);
        alert('Failed to connect to the server.');
      }
    }
</script>
<script>
function copyReferralLink() {
  const input = document.getElementById('refLink');
  input.select();
  document.execCommand('copy');
  alert('Referral link copied to clipboard!');
}
</script>
</body>
</html>