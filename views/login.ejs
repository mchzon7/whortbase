<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Authenticating...</title>
  <!-- Telegram WebApp JS SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      background-color: #121212;
      color: #ffffff;
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }
    .spinner {
      border: 4px solid rgba(255, 255, 255, 0.1);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border-left-color: #0088cc;
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .status-text {
      margin-top: 15px;
      font-size: 16px;
    }
  </style>
</head>
<body>

  <div class="spinner"></div>
  <div class="status-text" id="status">Connecting to Telegram...</div>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
  if (window.Telegram && window.Telegram.WebApp) {
    const tg = window.Telegram.WebApp;
    tg.ready();

    // 1. Get referral code from Telegram Direct Link startapp parameter
    const refCode = tg.initDataUnsafe?.start_param || null;

    // 2. Pass initData + refCode to your backend authentication endpoint
    try {
      const res = await fetch('/api/auth/telegram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          initData: tg.initData,
          refCode: refCode
        })
      });

      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirectTo;
      }
    } catch (err) {
      console.error('Auth sync error:', err);
    }
  }
});
  </script>
</body>
</html>