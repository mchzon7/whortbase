<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Naija Whot</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>body { background-color: #121212; color: #fff; }</style>
</head>
<body class="d-flex align-items-center vh-100">
  <div id="telegramBlocker" class="container col-md-5 text-center d-none">
    <div class="card bg-dark text-white border-danger p-4">
      <h3 class="text-danger mb-3">⚠️ Access Denied</h3>
      <p>This app is strictly available via <strong>Telegram Mini App</strong>.</p>
    </div>
  </div>

  <div id="appContainer" class="container col-md-4">
    <div class="card bg-dark text-white border-secondary p-4 text-center">
      <h3 class="text-warning mb-3">Welcome to Naija Whot</h3>
      <p class="text-secondary">Account registration is automatically verified using your Telegram Account.</p>
      
      <div id="errorAlert" class="alert alert-danger d-none"></div>
      <button id="tgRegBtn" class="btn btn-warning w-100 fw-bold my-2" onclick="processTelegramRegister()">Complete Registration</button>
    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', async () => {
  if (window.Telegram && window.Telegram.WebApp) {
    const tg = window.Telegram.WebApp;
    tg.ready();

    // 1. Get referral code from Telegram Direct Link startapp parameter
    const refCode = tg.initDataUnsafe?.start_param || null;

    // 2. Pass initData + refCode to your backend authentication endpoint
    try {
      const res = await fetch('/api/auth/telegram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          initData: tg.initData,
          refCode: refCode
        })
      });

      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirectTo;
      }
    } catch (err) {
      console.error('Auth sync error:', err);
    }
  }
});
  </script>
</body>
</html>