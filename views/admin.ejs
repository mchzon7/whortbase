<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Naija Whot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>body { background-color: #121212; color: #fff; }</style>
   <!-- Telegram WebApp SDK & Client Enforcement -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <script>
    (function enforceTelegramView() {
      const isTelegramSDK = window.Telegram && window.Telegram.WebApp;
      const hasInitData = isTelegramSDK && window.Telegram.WebApp.initData !== "";

      if (!isTelegramSDK || !hasInitData) {
        document.addEventListener("DOMContentLoaded", function() {
          document.body.innerHTML = `
            <div style="text-align:center; padding:50px; font-family:sans-serif; background:#0b1d13; color:#fff; height:100vh; display:flex; flex-direction:column; justify-content:center; align-items:center;">
              <h2 style="color:#ff4d4d; margin-bottom:10px;">Access Denied</h2>
              <p style="max-width:400px; color:#ccc; line-height:1.5;">This app is configured to run exclusively inside the Telegram WebApp viewer. Direct browser access is disabled.</p>
            </div>
          `;
        });
      } else {
        window.Telegram.WebApp.ready();
        window.Telegram.WebApp.expand();
      }
    })();
  </script>
</head>
<body class="p-4">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="text-danger">Admin Command Center</h2>
      <a href="/dashboard" class="btn btn-outline-light">Dashboard</a>
    </div>

    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card bg-dark text-white border-danger p-3">
          <h5>Total Revenue (System Rake)</h5>
          <h2 class="text-success"><%= houseRevenue %> Points</h2>
        </div>
      </div>
    </div>

    <h4>User Management</h4>
    <table class="table table-dark table-striped border-secondary mb-5">
      <thead>
        <tr><th>User</th><th>Email</th><th>Role</th><th>Points Balance</th></tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr><td><%= u.username %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.pointsBalance %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <h4>Platform Financial Logs</h4>
    <table class="table table-dark table-striped border-secondary">
      <thead>
        <tr><th>User</th><th>Type</th><th>Amount</th><th>Channel</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% txns.forEach(t => { %>
          <tr>
            <td><%= t.user ? t.user.username : 'N/A' %></td>
            <td><%= t.type %></td>
            <td><%= t.amount %></td>
            <td><%= t.channel %></td>
            <td><span class="badge bg-<%= t.status === 'success' ? 'success' : 'warning' %>"><%= t.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>